{
  "name": "beatrider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "build:native": "CAP_BUILD=1 vite build",
    "cap:sync": "npm run build:native && cap sync",
    "ios": "npm run build:native && cap sync ios && cap open ios",
    "android": "npm run build:native && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "phaser": "3.90.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "vite": "^6.0.0"
  }
}
